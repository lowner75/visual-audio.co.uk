//- views/index.pug

extends layouts/main

block variables
  - const bodyClass = 'landing-page'
  - const bodyPage = 'landing'

block content

  //- Hero ...
  section.hero(data-theme="dark")

    //- Hero mask ...
    .mask

      //- Hero video ...
      video(id="landing-hero-video" loop muted playsinline poster="/images/videos/landing-hero-placeholder.jpg")
        source(src="/images/videos/landing-hero.mp4" type="video/mp4")

    //- Hero text ...
    .container
      .hero-text.position-absolute(style="top: 220px")
        .container
          .row
            .col-md-8.col-lg-7.order-2.order-md-1(style="text-shadow: 0px 0px 5px rgba(0,0,0,0.25)")
              
              h1.title-font.pt-5.mb-5(style="font-weight: 400; max-width: 90%") Welcome to 
                span(style="font-weight: 600") Visual
                span(style="font-weight: 300") Audio
              
              div.lead(style="font-size: 1.5em; font-weight: 400; color: #fff")
                span(style="font-weight: 600") Visual
                span(style="font-weight: 300") Audio 
                span is one of the UK's leading <b>lighting</b>, <b>sound</b> and <b>Audio Visual</b> (<b>AV</b>) events production companies. We create unforgettable experiences and outstanding events.

              //- Down arrow button ...
              //-a(href="#intro")
              .position.absolute.pt-5.mt-3(style="left: 50%")
                  a.d-flex.align-items-center.justify-content-center.rounded-circle(style="height: 70px; width: 70px; border: solid 1px #666")
                    svg.icon(viewBox="0 0 24 24" style="width: 16px; height: 16px; fill: var(--text);")
                      use(xlink:href="/images/icons/icon-arrow-down.svg")

    //- Intro ...
    section.container.py-5.bg-black(id="intro" style="max-width: 800px" data-theme="dark")
      .row.py-5
        .col-12.text-center.py-5
          .lead.pb-3.text-secondary(style="font-weight: 300") Why VisualAudio 
          h1.text-white(style="font-weight: 300") Lighting, Sound, and Audio Visual. We provide a single port of call for everything AV.<br>We collaborate. We create.
          .mt-5
            a.d-inline.px-5.py-3.border.text-white.rounded-pill(href="#" style="text-decoration: none") ABOUT US

//- Services ...
  .container-fluid.bg-white.section(id="services")
    .container.flex
      .row
        .col-12.text-center(style="max-width: 700px")
          .lead.pb-3.text-secondary(style="font-weight: 300") Audio Visual Services 
          h1.text-dark(style="font-weight: 300") From seamless event production, to state-of-the-art AV installations, and immersive digital experiences, we have the expertise and technology to make it happen.
          .pb-5

    .container.text-dark(style="max-width: 1200px")
      .row.gx-3
        .col-12.col-lg-4
          .h-100.rounded-0
            .p-2
              .px-3.pt-2.pb-4
                .d-flex.align-items-center
                  img.py-3.me-2(src="/img/icons/menu-light/icon-menu-01.png" style="height: 50px; width: auto")
                  .lead.fw-bold Private Events
                .text-secondary.pb-3 Unforgettable private events with a seamless service adding a personalized touch. Let us bring your vision to life in an elegant style.
                a(href="") Learn more about Private Events
        .col-12.col-lg-4
          .h-100.rounded-0
            .p-2
              .px-3.pt-2.pb-4
                .d-flex.align-items-center
                  img.py-3.me-2(src="/img/icons/menu-light/icon-menu-02.png" style="height: 50px; width: auto")
                  .lead.fw-bold Product Launches
                .text-secondary.pb-3 Activate your brand in style with a bespoke product launch, enhanced by state-of-the-art audiovisual (AV) technology. Craft an immersive experience that captivates your audience and leaves an enduring impression of sophistication and innovation.
                a(href="") Learn more about Product Launches
        .col-12.col-lg-4
          .h-100.rounded-0
            .p-2
              .px-3.pt-2.pb-4
                .d-flex.align-items-center
                  img.py-3.me-2(src="/img/icons/menu-light/icon-menu-03.png" style="height: 50px; width: auto")
                  .lead.fw-bold Conferences
                .text-secondary.pb-3 Elevating conferences globally with cutting-edge AV technology and masterful production, creating an unforgettable experience of excellence and impact. Every detail is flawlessly executed, ensuring a seamless and visually stunning event.
                a(href="") Learn more about Conferences
      .row.gx-3.py-lg-3
        .col-12.col-lg-4
          .h-100
            .p-2
              .px-3.pt-2.pb-4
                .d-flex.align-items-center
                  img.py-3.m-2(src="/img/icons/menu-light/icon-menu-04.png" style="width: 30px")
                  .lead.fw-bold Fashion Shows
                .py-2.text-secondary.pb-3 With a wealth of experience, we have flawlessly executed fashion shows for some of the industry's most renowned names. From Concept to reality. Capturing every detail.
                a(href="") Learn more about Fashion Shows
