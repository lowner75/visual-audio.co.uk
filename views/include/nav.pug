//- views/include/nav.pug

nav.bg-black
  .nav-container.container-fluid
    .container
      .row.nav.my-2.py-4.py-xl-1
        .col-9.d-flex.flex-row.align-items-center
          .d-flex.flex-row.align-items-center.justify-content-start.nav-logo
            a(href="/beta" style="text-decoration: none")
              img.me-2(src="/images/logo.png" style="width: 36px")
            a.d-block.me-2.me-lg-5.pe-2(href="/beta" style="text-decoration: none; font-size: 20px; font-weight: 500") Visual<span style="font-weight: 300">Audio</span>
        .col-3.d-none.d-xl-flex.align-items-center.justify-content-end
          a#services.d-none.d-lg-block.px-3.py-4.me-3(style="cursor: pointer")
            .flex-center Services
              span.ps-1.ms-2
                svg.icon(viewBox="0 0 24 24" style="width: 12px; height: 12px; fill: var(--text); margin-top: -2px;")
                  use(xlink:href="/images/icons/icon-menu-down.svg")
          a#av-hire.d-none.d-lg-block.px-3.py-4.me-4(style="cursor: pointer; text-wrap: nowrap;")
            .flex-center AV Hire
              span.ps-1.ms-2
                svg.icon(viewBox="0 0 24 24" style="width: 12px; height: 12px; fill: var(--text); margin-top: -2px;")
                  use(xlink:href="/images/icons/icon-menu-down.svg")
          a.d-none.d-lg-block.py-4.me-5.text-white(href="/beta/work") Work
          a.d-none.d-lg-block.py-4.me-5.text-white(href="/beta/contact") Contact

          //-#user-icon.position-relative
            if user && user.isAdmin
              a.py-4(href="/beta/VADB/")
                svg.icon(viewBox="0 0 24 24" style="width: 18px; height: 18px; fill: var(--text);")
                  use(xlink:href="/images/icons/icon-user.svg")
            else 
              a.py-4(href="/beta/auth/login")
                svg.icon(viewBox="0 0 24 24" style="width: 18px; height: 18px; fill: var(--text);")
                  use(xlink:href="/images/icons/icon-user.svg")
            #user-dropdown.position-absolute.rounded
              .flex.flex-row.justify-content-start.p-3(style="min-width: 300px; border-bottom: solid 1px var(--border-color)")
                .flex.rounded-circle.fw-bold.me-3(style="width: 30px; height: 30px; font-size: 12px; background-color: var(--va-color); color: #fff") #{Array.from(user.firstName)[0]}#{Array.from(user.lastName)[0]}
                .d-block(style="line-height: 1.3")
                  span.fw-bold(style="font-size: 14px") #{user.firstName} #{user.lastName}<br/>
                  span(style="font-size: 10px") #{user.email}
              .d-block.py-3(style="border-bottom: solid 1px var(--border-color)")
                .px-3.pb-2.flex.flex-row.justify-content-start.theme-link.theme-light(onclick='changeTheme("light")')
                  .fa-regular.fa-sun(style="margin-right: 12px")
                  .me-3 Light Theme
                .px-3.pb-0.flex.flex-row.justify-content-start.theme-link.theme-dark(onclick='changeTheme("dark")')
                  .fa-regular.fa-moon(style="margin-left: 2px; margin-right: 13px")
                  .me-3 Dark Theme (Default)
              a.theme-link(href="/logout/" style="font-size: 10pt")
                .p-3.flex.flex-row.justify-content-start
                  .fa-solid.fa-arrow-right-from-bracket.me-2(style="font-size: 10pt")
                  div Log Out

        .col-3.d-flex.p-0.d-xl-none.align-items-end.justify-content-end(style="z-index: 500")
          .menu-btn-container(style="z-index: 250")
            .menu-btn.not-active
              span 
              span 
              span

