//- views/include/nav.pug

nav.nav
  .nav__inner.container.my-2.py-4.py-xl-1
    .nav__left
      a.nav__logo(href="/beta")
        img.nav__logo-img.me-2(src="/images/logo.png")
        span.nav__logo-text(href="/beta") Visual
          span(style="font-weight: 300") Audio
    .nav__right.d-none.d-xl-flex
      a#services.d-none.d-lg-block.px-3.py-4.me-3
        .flex-center Services
          span.ps-1.ms-2
            svg.icon(viewBox="0 0 24 24" style="width: 12px; height: 12px; fill: var(--text); margin-top: -2px;")
              use(xlink:href="/images/icons/icon-menu-down.svg")
      a#av-hire.d-none.d-lg-block.px-3.py-4.me-4(href="/beta/av-hire" style="text-wrap: nowrap;")
        .flex-center AV Hire
          span.ps-1.ms-2
            svg.icon(viewBox="0 0 24 24" style="width: 12px; height: 12px; fill: var(--text); margin-top: -2px;")
              use(xlink:href="/images/icons/icon-menu-down.svg")
      a.d-none.d-lg-block.py-4.me-5.text-white(href="/beta/work") Work
      a.d-none.d-lg-block.py-4.text-white(href="/beta/contact") Contact

    //- Mobile menu button
    .p-0.align-items-end.justify-content-end(style="z-index: 500")
      .menu-btn-container(style="z-index: 250")
        .menu-btn.not-active
          span 
          span 
          span
    
  //- Sub menu system
  .sub-menu-system
    .container

      //- Services sub menu
      include ./nav-services.pug

      //- AV Hire sub menu
      include ./nav-av-hire.pug