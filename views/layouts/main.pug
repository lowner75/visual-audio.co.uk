//- views/layouts/main.pug

block variables

doctype html
html(lang='en')
  head
    include ../include/head.pug 

  body(
    class=typeof bodyClass !== 'undefined' ? bodyClass : ''
    data-page=typeof bodyPage !== 'undefined' ? bodyPage : null
    data-scroll="smooth"
  )


    //- Preloader
    include ../include/preloader.pug

    //- Navigation
    include ../include/nav.pug 

    //- Main content
    main(id="main" role="main")
      block content

      //- Contact form
        include ../include/contact-form.pug

      //- Footer
        include ../include/footer.pug

      //- Page-specific JS
      include ../include/scripts.pug

block modals